{
  "name": "xray-extension",
  "version": "0.8.0",
  "private": true,
  "description": "NOSTR-sourced URL metadata & article capture — Chrome/Firefox MV3 WebExtension.",
  "repository": "github:bryanmatthewsimonson/xray",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "web-ext lint --source-dir . --self-hosted",
    "lint:js": "node scripts/eslint-ratchet.mjs",
    "check:version": "node scripts/check-version-lockstep.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tools/smoke/run.mjs",
    "version:set": "node scripts/set-version.mjs",
    "icons": "node scripts/build-icons.mjs",
    "docs:disciplines": "node tools/gen-discipline-docs.mjs",
    "docs:journal": "node tools/gen-journal-index.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "pdfjs-dist": "^6.3.289",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "playwright": "1.63.0",
    "web-ext": "^10.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "shell-quote": "^1.9.0"
  },
  "webExt": {
    "ignoreFiles": [
      "companion",
      "companion/**",
      "dist/_smoke-*",
      "tools/smoke/out",
      "tools/smoke/out/**",
      "_metadata",
      "_metadata/**",
      "eslint.config.mjs"
    ]
  }
}
